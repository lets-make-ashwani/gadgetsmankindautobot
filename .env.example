# ==============================================================
# GADGETS MANKIND AUTOMATION - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this to .env or set these in Render.com Environment Variables
# ==============================================================

# Telegram API Credentials (from my.telegram.org)
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_CHANNEL=allterapost

# Render.com Telegram String Session (Portable Cloud Authentication)
TELEGRAM_STRING_SESSION=your_telethon_string_session_token

# Groq AI Inference Credentials (from console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_TTS_VOICE=en-US-ChristopherNeural

# Meta & Instagram Graph API Credentials (Permanent Tokens)
META_PAGE_ID=your_facebook_page_id
META_PAGE_NAME=Gadgets mankind
META_PAGE_TOKEN=your_permanent_page_access_token
META_INSTAGRAM_ID=your_instagram_business_account_id
META_INSTAGRAM_USERNAME=gadgetsmankind

# Automation Pipeline Cadence
PIPELINE_ORDER=oldest_to_newest
PIPELINE_INTERVAL_HOURS=3
AUTO_DUB_ENGLISH=true
POST_TO_INSTAGRAM=true
POST_TO_FACEBOOK=true

# MongoDB Atlas External Database (Cloud state persistence across container restarts)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=gadgets_mankind
